      animation-duration: 22s;
      animation-delay: -4s;
    }
    @keyframes home-orb-drift {
      0% {
        transform: translate3d(0, 0, 0) scale(1);
      }
      100% {
        transform: translate3d(30px, -24px, 0) scale(1.06);
