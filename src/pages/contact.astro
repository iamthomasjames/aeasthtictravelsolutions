---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title={`Contact · ${site.name}`} description={`Contact ${site.name} for Kerala tours, curated itineraries, and premium fleet rentals.`}>
  <main class="mx-auto max-w-container-max px-margin-mobile py-section-padding md:px-margin-desktop">
    <h1 class="font-headline-lg text-headline-lg text-primary mb-6">Contact</h1>
    <p class="font-body-md text-body-md text-on-surface-variant mb-8 max-w-2xl">
      For bespoke itineraries, fleet bookings, and partnerships, reach our team directly or use the{' '}
      <a class="text-secondary underline hover:opacity-80" href="/planner">Vacation Planner</a>.
    </p>
    <a
      class="bg-primary text-on-primary inline-flex rounded-full px-8 py-3 font-label-md text-label-md transition-opacity hover:opacity-90"
      href={`mailto:${site.inquiryEmail}`}
    >
      Email {site.inquiryEmail}
    </a>
  </main>
</BaseLayout>
