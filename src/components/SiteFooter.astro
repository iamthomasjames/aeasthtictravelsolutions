---
import { site } from '../site.config';
---

<footer
  class="bg-primary-container dark:bg-primary-container w-full rounded-none text-on-primary-container dark:text-on-primary-container"
>
  <div
    class="mx-auto grid max-w-container-max grid-cols-1 gap-gutter px-margin-mobile py-section-padding md:grid-cols-4 md:px-margin-desktop"
  >
    <div class="md:col-span-2">
      <div class="font-headline-md text-headline-sm text-on-primary-container mb-6">
        {site.name}
      </div>
      <p class="font-body-md text-body-md mb-8 max-w-sm text-on-primary-container/80">
        {site.tagline}
      </p>
    </div>
    <div class="flex flex-col gap-4">
      <a
        class="font-body-md text-body-md text-on-primary-container/80 transition-colors hover:text-on-primary-container"
        href="/#rentals"
      >
        Fleet
      </a>
      <a
        class="font-body-md text-body-md text-on-primary-container/80 transition-colors hover:text-on-primary-container"
        href="/packages"
      >
        Packages
      </a>
      <a
        class="font-body-md text-body-md text-on-primary-container/80 transition-colors hover:text-on-primary-container"
        href="/contact"
      >
        Contact
      </a>
    </div>
    <div class="flex flex-col gap-4">
      <a
        class="font-body-md text-body-md text-on-primary-container/80 transition-colors hover:text-on-primary-container"
        href="/terms"
      >
        Terms
      </a>
      <a
        class="font-body-md text-body-md text-on-primary-container/80 transition-colors hover:text-on-primary-container"
        href="/privacy"
      >
        Privacy
      </a>
    </div>
    <div class="border-on-primary-container/20 md:col-span-4 mt-4 border-t pt-8">
      <p class="text-sm text-on-primary-container/60 font-body-md text-body-md">
        © {site.copyrightYear}
        {site.name}. Crafted for the Discerning Explorer.
      </p>
    </div>
  </div>
</footer>
