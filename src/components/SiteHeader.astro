---
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const links = [
  { href: '/explore', label: 'Explore', section: null as string | null },
  { href: '/#rentals', label: 'Rentals', section: 'rentals' },
  { href: '/#planner', label: 'Planner', section: 'planner' },
  { href: '/#about', label: 'About', section: 'about' },
] as const;

const activeClass =
  'border-primary pb-1 text-primary dark:border-primary-fixed dark:text-primary-fixed border-b-2 font-label-md text-label-md hover:opacity-80 transition-all duration-300';
const inactiveClass =
  'text-on-surface-variant hover:text-primary dark:text-surface-variant dark:hover:text-primary-fixed font-label-md text-label-md transition-colors hover:opacity-80 duration-300';

function linkClasses(href: string) {
  if (href === '/explore') {
    const active = pathname === '/explore' || pathname.startsWith('/explore/');
    return active ? activeClass : inactiveClass;
  }
  const legacy: Record<string, string> = {
    '/#rentals': '/rentals',
    '/#planner': '/planner',
    '/#about': '/about',
  };
  const legacyPath = legacy[href];
  if (legacyPath) {
    const onLegacy = pathname === legacyPath || pathname.startsWith(`${legacyPath}/`);
    if (onLegacy) return activeClass;
    if (pathname === '/') return `${inactiveClass} home-section-nav`;
    return inactiveClass;
  }
  return inactiveClass;
}
---

<nav
  class="border-outline-variant/30 sticky top-0 z-50 w-full border-b-0 bg-surface/90 backdrop-blur-md shadow-[0px_10px_30px_rgba(11,61,46,0.05)] dark:bg-primary/90 dark:text-primary-fixed"
>
  <div
    class="mx-auto flex h-20 w-full max-w-container-max items-center justify-between px-margin-mobile md:px-margin-desktop"
  >
    <a
      href="/"
      class="font-headline-md text-headline-sm font-semibold tracking-tight text-primary transition-opacity hover:opacity-80 dark:text-primary-fixed"
    >
      Aesthetica Travels
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map(({ href, label, section }) => (
          <li>
            <a
              class:list={[linkClasses(href)]}
              href={href}
              data-home-nav={section ?? undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-4">
      <a
        href="/explore"
        class="hidden items-center justify-center text-primary transition-all hover:opacity-80 md:flex dark:text-primary-fixed"
        aria-label="Search destinations"
      >
        <span class="material-symbols-outlined text-2xl">search</span>
      </a>
      <a
        href="/#planner"
        class="home-cta-pulse hidden rounded-full bg-primary px-6 py-3 font-label-md text-label-md text-on-primary transition-all hover:opacity-90 md:inline-flex dark:bg-primary-fixed dark:text-on-primary-fixed"
      >
        Inquire Now
      </a>

      <details class="relative md:hidden">
        <summary
          class="list-none cursor-pointer text-primary marker:hidden dark:text-primary-fixed [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <span class="material-symbols-outlined">menu</span>
        </summary>
        <div
          class="border-outline-variant/40 bg-surface-container-lowest absolute right-0 z-50 mt-3 min-w-[220px] rounded-xl border py-3 shadow-[0px_10px_30px_rgba(11,61,46,0.12)]"
        >
          {
            links.map(({ href, label }) => (
              <a
                class="hover:bg-surface-container-low block px-5 py-3 font-label-md text-label-md text-on-surface-variant hover:text-primary"
                href={href}
              >
                {label}
              </a>
            ))
          }
          <a
            class="hover:bg-surface-container-low mt-2 block border-outline-variant/40 border-t px-5 py-3 font-label-md text-label-md text-primary"
            href="/#planner"
          >
            Inquire Now
          </a>
        </div>
      </details>
    </div>
  </div>
</nav>

<style>
  .home-section-nav.home-nav-active {
    border-bottom-width: 2px;
    border-color: var(--color-primary);
    color: var(--color-primary);
    padding-bottom: 0.25rem;
  }
  :global(.dark) .home-section-nav.home-nav-active {
    border-color: var(--color-primary-fixed);
    color: var(--color-primary-fixed);
  }
  @keyframes home-cta-glow {
    0%,
    100% {
      box-shadow:
        0 0 0 0 rgba(188, 237, 215, 0.45),
        0 8px 24px rgba(11, 61, 46, 0.2);
    }
    50% {
      box-shadow:
        0 0 0 10px rgba(188, 237, 215, 0),
        0 12px 32px rgba(11, 61, 46, 0.28);
    }
  }
  .home-cta-pulse {
    animation: home-cta-glow 2.8s ease-in-out infinite;
  }
</style>

{
  pathname === '/' && (
    <script is:inline>
      (function () {
        const navs = Array.from(document.querySelectorAll('[data-home-nav]'));
        if (!navs.length) return;
        const sections = ['rentals', 'planner', 'about']
          .map((id) => document.getElementById(id))
          .filter(Boolean);
        if (!sections.length) return;

        function clearActive() {
          navs.forEach((a) => a.classList.remove('home-nav-active'));
        }

        function setActive(id) {
          clearActive();
          const link = document.querySelector('[data-home-nav="' + id + '"]');
          link?.classList.add('home-nav-active');
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting && e.target.id) setActive(e.target.id);
            });
          },
          { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
        );

        sections.forEach((s) => io.observe(s));

        const hash = window.location.hash.replace('#', '');
        if (hash && ['rentals', 'planner', 'about'].includes(hash)) {
          setActive(hash);
        }
      })();
    </script>
  )
}
